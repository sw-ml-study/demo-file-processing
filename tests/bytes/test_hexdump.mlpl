include "src/bytes/validate.mlpl";
include "src/bytes/hex.mlpl";

@test {name: "hexdump handles empty and singleton inputs", tags: ["bytes", "hexdump", "boundary"]}
def u:test_hexdump_small() {
  "Verify empty text and two-digit zero-padded singleton formatting.";
  u:assert_eq(u:hexdump([], 16), ok(""), "empty byte vector renders empty text");
  u:assert_eq(u:hexdump([255], 16), ok("00000000  FF"), "singleton uses uppercase two-digit hex")
}

@test {name: "hexdump starts a new offset row at the width boundary", tags: ["bytes", "hexdump", "boundary"]}
def u:test_hexdump_width_boundary() {
  "Verify byte sixteen starts a second offset-prefixed row.";
  expected = decode_bytes(concat(tokenize_bytes("00000000  00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F"), concat([10], tokenize_bytes("00000010  10"))));
  u:assert_eq(u:hexdump(range(17), 16), ok(expected), "seventeen bytes span two lines")
}

@test {name: "hexdump rejects invalid byte and width inputs", tags: ["bytes", "hexdump", "invalid"]}
def u:test_hexdump_invalid() {
  "Verify byte-domain, rank, and width errors are Result-based.";
  u:assert_err(u:hexdump([0, 256], 16), "out-of-range byte");
  u:assert_err(u:hexdump([0, 1.5], 16), "fractional byte");
  u:assert_err(u:hexdump(7, 16), "scalar byte input");
  u:assert_err(u:hexdump(reshape(range(4), [2, 2]), 16), "rank-two byte input");
  u:assert_err(u:hexdump([0], 0), "zero width");
  u:assert_err(u:hexdump([0], 1.5), "fractional width")
}

u:run_registered_tests()
