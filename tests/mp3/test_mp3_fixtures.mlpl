include "src/bytes/validate.mlpl";
include "src/binary/endian_decode.mlpl";
include "src/binary/bit_fields.mlpl";
include "src/id3/inspect.mlpl";
include "src/mp3/scanner.mlpl";

@test {name: "committed MP3 fixtures preserve chunk-invariant descriptors and statistics", tags: ["mp3", "id3", "fixtures", "chunks"]}
def u:test_mp3_fixture_invariance() { "Inspect the generated structural VBR fixture at all required chunk budgets.";
  path = "fixtures/mp3/synthetic-vbr-id3.mp3"; size = file_size(path)?; chunks = [1, 7, 64, 65536]; index = 0; baseline_tag = u:inspect_id3v2(path, 1, 4096, 16, 256)?; baseline_scan = u:scan_mpeg_layer3(path, 1, baseline_tag.audio_offset, size, baseline_tag.audio_bytes, 16)?;
  while lt(index, tally(chunks)) { chunk = take(chunks, 0, index); tag = u:inspect_id3v2(path, chunk, 4096, 16, 256)?; scan = u:scan_mpeg_layer3(path, chunk, tag.audio_offset, size, tag.audio_bytes, 16)?; u:assert_eq(tag, baseline_tag, "ID3 descriptor chunk invariance")?; u:assert_eq(scan, baseline_scan, "MPEG statistics chunk invariance")?; index = index + 1 };
  u:assert_eq([baseline_tag.tag_bytes, baseline_tag.audio_bytes, baseline_scan.frames, baseline_scan.min_bitrate_kbps, baseline_scan.max_bitrate_kbps], [76, 1356, 3, 128, 160], "fixture golden facts")?;
  u:assert_eq(baseline_scan.bitrate_histogram, [0, 0, 0, 0, 0, 0, 0, 0, 0, 2, 1, 0, 0, 0, 0], "fixture bitrate distribution")?;
  u:assert_eq(baseline_scan.channel_mode_histogram, [0, 2, 0, 1], "fixture channel-mode distribution")?;
  u:assert_eq([baseline_scan.min_frame_length, baseline_scan.max_frame_length], [417, 522], "fixture frame-size range")
}

@test {name: "decodable oracle fixture agrees with bounded structural inspection", tags: ["mp3", "id3", "fixture", "oracle"]}
def u:test_mp3_oracle_fixture_structure() { "Keep default tests tool-independent while pinning the MLPL side of the opt-in ffprobe comparison.";
  path = "fixtures/mp3/tone-vbr-id3.mp3"; size = file_size(path)?; tag7 = u:inspect_id3v2(path, 7, 4096, 16, 256)?; tag64 = u:inspect_id3v2(path, 64, 4096, 16, 256)?; scan7 = u:scan_mpeg_layer3(path, 7, tag7.audio_offset, size, tag7.audio_bytes, 64)?; scan64 = u:scan_mpeg_layer3(path, 64, tag64.audio_offset, size, tag64.audio_bytes, 64)?;
  u:assert_eq(tag7, tag64, "oracle tag chunk invariance")?; u:assert_eq(scan7, scan64, "oracle scan chunk invariance")?; u:assert_eq(tag7.title, "Bounded 440 Hz tone", "oracle fixture title")?; u:assert_eq([scan7.frames, scan7.sample_rate_hz], [12, 44100], "oracle structural facts including Xing information frame")
}

@test {name: "committed malformed ID3 fixture is rejected", tags: ["id3", "fixture", "malformed"]}
def u:test_malformed_id3_fixture() { "Keep the declared-length truncation case visible as a committed fourteen-byte artifact.";
  u:assert_err(u:inspect_id3v2("fixtures/mp3/malformed-truncated-id3.mp3", 7, 4096, 16, 256), "declared tag exceeds snapshot")
}

u:run_registered_tests()
