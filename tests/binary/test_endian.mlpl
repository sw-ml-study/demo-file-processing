include "src/bytes/validate.mlpl";
include "src/binary/endian_decode.mlpl";
include "src/binary/endian_encode.mlpl";

@test {name: "endian decoders match golden widths", tags: ["binary", "endian", "golden"]}
def u:test_endian_golden() { "Verify one-, two-, three-, four-, and six-byte decode vectors.";
  bytes = [1, 2, 3, 4, 254, 255];
  u:assert_eq(u:decode_uint(bytes, 0, 1, "be"), ok(1), "u8");
  u:assert_eq(u:decode_uint(bytes, 0, 2, "be"), ok(258), "u16 big endian");
  u:assert_eq(u:decode_uint(bytes, 0, 3, "le"), ok(197121), "u24 little endian");
  u:assert_eq(u:decode_uint(bytes, 0, 4, "be"), ok(16909060), "u32 big endian");
  u:assert_eq(u:decode_uint(fill([6], 255), 0, 6, "be"), ok(281474976710655), "maximum exact u48")
}

@test {name: "endian encoders round trip exact widths", tags: ["binary", "endian", "round-trip"]}
def u:test_endian_round_trip() { "Verify both byte orders and the exact six-byte boundary.";
  u:assert_eq(u:encode_uint(0, 1, "be"), ok([0]), "zero u8")?;
  u:assert_eq(u:decode_uint(u:encode_uint(258, 2, "be")?, 0, 2, "be"), ok(258), "u16 big-endian round trip")?;
  u:assert_eq(u:decode_uint(u:encode_uint(258, 2, "le")?, 0, 2, "le"), ok(258), "u16 little-endian round trip")?;
  u:assert_eq(u:decode_uint(u:encode_uint(1193046, 3, "be")?, 0, 3, "be"), ok(1193046), "u24 big-endian round trip")?;
  u:assert_eq(u:decode_uint(u:encode_uint(1193046, 3, "le")?, 0, 3, "le"), ok(1193046), "u24 little-endian round trip")?;
  u:assert_eq(u:decode_uint(u:encode_uint(4294967295, 4, "be")?, 0, 4, "be"), ok(4294967295), "u32 big-endian round trip")?;
  u:assert_eq(u:decode_uint(u:encode_uint(4294967295, 4, "le")?, 0, 4, "le"), ok(4294967295), "u32 little-endian round trip")?;
  u:assert_eq(u:decode_uint(u:encode_uint(281474976710655, 6, "be")?, 0, 6, "be"), ok(281474976710655), "maximum u48 big-endian round trip")?;
  u:assert_eq(u:decode_uint(u:encode_uint(281474976710655, 6, "le")?, 0, 6, "le"), ok(281474976710655), "maximum u48 little-endian round trip")
}

@test {name: "endian codecs reject invalid ranges and widths", tags: ["binary", "endian", "invalid"]}
def u:test_endian_invalid() { "Verify containment, exactness, endian spelling, and six-byte policy.";
  u:assert_err(u:decode_uint([1, 2], 1, 2, "be"), "decode past end");
  u:assert_err(u:decode_uint([1, 2], 0 - 1, 1, "be"), "negative offset");
  u:assert_err(u:decode_uint([1, 2], 0.5, 1, "be"), "fractional offset");
  u:assert_err(u:decode_uint([1], 0, 0, "be"), "zero width");
  u:assert_err(u:decode_uint([1], 0, 1.5, "be"), "fractional width");
  u:assert_err(u:decode_uint(range(7), 0, 7, "be"), "seven-byte scalar is not exact");
  u:assert_err(u:decode_uint([1], 0, 1, "middle"), "unknown byte order");
  u:assert_err(u:encode_uint(256, 1, "be"), "value does not fit");
  u:assert_err(u:encode_uint(0 - 1, 1, "be"), "negative value");
  u:assert_err(u:encode_uint(1.5, 2, "be"), "fractional value");
  u:assert_err(u:encode_uint(1, 7, "be"), "seven-byte scalar policy");
  u:assert_err(u:encode_uint(1, 1, "middle"), "unknown byte order")
}

u:run_registered_tests()
