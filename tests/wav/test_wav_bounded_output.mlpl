include "src/bytes/validate.mlpl";
include "src/binary/slice.mlpl";
include "src/binary/endian_decode.mlpl";
include "src/binary/endian_encode.mlpl";
include "src/wav/model.mlpl";
include "src/wav/chunks.mlpl";
include "src/wav/parse.mlpl";
include "src/wav/range_inspect.mlpl";
include "src/wav/bounded_output.mlpl";

def u:wav_output_fresh(path) {
  "Remove a stale WAV test artifact before exercising no-overwrite output behavior.";
  remove_path(path);
  ok(1)
}

@test {name: "bounded canonical WAV copy is chunk invariant", tags: ["wav", "output", "bounded", "copy"]}
def u:test_wav_bounded_copy() {
  "Copy canonical samples at four chunk sizes and compare exact bytes with the source oracle.";
  source = "fixtures/wav/minimal-mono8.wav";
  expected = read_bytes(source)?;
  chunks = [1, 2, 7, 65536];
  index = 0;
  while lt(index, tally(chunks)) {
    chunk = take(chunks, 0, index);
    path = if eq(chunk, 1) {
      ".wav-bounded-copy-1.wav"
    } else {
      if eq(chunk, 2) {
        ".wav-bounded-copy-2.wav"
      } else {
        if eq(chunk, 7) {
          ".wav-bounded-copy-7.wav"
        } else {
          ".wav-bounded-copy-large.wav"
        }
      }
    };
    u:wav_output_fresh(path);
    result = u:bounded_wav_output(source, path, "copy", chunk, 48, 8, 1)?;
    u:assert_eq(read_bytes(path), ok(expected), "canonical copy bytes")?;
    u:assert_eq([result.data_bytes, result.output_bytes], [3, 48], "copy sizes")?;
    remove_path(path);
    index = index + 1
  };
  ok(1)
}

@test {name: "bounded WAV copy canonicalizes unknown chunks", tags: ["wav", "output", "canonical", "semantic"]}
def u:test_wav_bounded_canonical() {
  "Remove an odd padded JUNK chunk while preserving the parsed PCM semantics and pad.";
  path = ".wav-bounded-canonical.wav";
  u:wav_output_fresh(path);
  result = u:bounded_wav_output("fixtures/wav/odd-unknown-mono8.wav", path, "copy", 7, 46, 8, 1)?;
  output = u:parse_wav(read_bytes(path)?, 46, 8)?;
  u:assert_eq([output.data, output.frames, output.unknown_chunks], [[9], 1, 0], "canonical semantic output")?;
  u:assert_eq([result.output_bytes, result.padding_bytes, result.unknown_chunks_removed], [46, 1, 1], "canonical layout")?;
  remove_path(path);
  ok(1)
}

@test {name: "bounded WAV transform visibly inverts unsigned PCM", tags: ["wav", "output", "transform", "oracle"]}
def u:test_wav_bounded_invert() {
  "Invert three unsigned samples and compare the decoded semantic oracle.";
  path = ".wav-bounded-invert.wav";
  u:wav_output_fresh(path);
  result = u:bounded_wav_output("fixtures/wav/minimal-mono8.wav", path, "invert_u8", 2, 48, 8, 1)?;
  output = u:parse_wav(read_bytes(path)?, 48, 8)?;
  u:assert_eq(output.data, [255, 128, 0], "inverted sample values")?;
  u:assert_eq([result.chunks, result.last_chunk_bytes, output.frames], [2, 1, 3], "bounded transform shape")?;
  remove_path(path);
  ok(1)
}

@test {name: "bounded WAV output rejects unsafe inputs before writing", tags: ["wav", "output", "invalid", "budget"]}
def u:test_wav_bounded_invalid() {
  "Reject existing destinations, budgets, modes, malformed sources, and invalid chunk sizes.";
  destination = ".wav-bounded-invalid.wav";
  u:wav_output_fresh(destination);
  append_bytes(destination, [9])?;
  u:assert_err(u:bounded_wav_output("fixtures/wav/minimal-mono8.wav", destination, "copy", 7, 48, 8, 1), "existing destination")?;
  u:assert_eq(read_bytes(destination), ok([9]), "existing bytes preserved")?;
  remove_path(destination);
  u:assert_err(u:bounded_wav_output("fixtures/wav/minimal-mono8.wav", destination, "copy", 7, 47, 8, 1), "output budget")?;
  u:assert_err(u:bounded_wav_output("fixtures/wav/minimal-mono8.wav", destination, "gain", 7, 48, 8, 1), "unknown mode")?;
  u:assert_err(u:bounded_wav_output("fixtures/wav/minimal-mono8.wav", destination, "copy", 0, 48, 8, 1), "zero chunk")?;
  u:assert_err(u:bounded_wav_output("fixtures/bytes/boundary-17.bin", destination, "copy", 7, 64, 8, 1), "non WAV")?;
  ok(1)
}

u:run_registered_tests()
