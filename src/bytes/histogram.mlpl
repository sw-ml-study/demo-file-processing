def u:byte_histogram(bytes) {
  "Count every byte value with an equality outer product and axis reduction.";
  if u:bytes_valid(bytes) {
    if eq(tally(bytes), 0) {
      ok(fill([256], 0))
    } else {
      ok(reduce_add(table(:eq, range(256), bytes), 1))
    }
  } else {
    err({kind: "bytes", message: "byte_histogram expects a byte vector"})
  }
}

def u:histogram_nonzero(counts) {
  "Return parallel byte/count vectors for populated bins in a 256-bin histogram.";
  if equal(type_of(counts), "array") * eq(rank(counts), 1) * eq(tally(counts), 256) {
    mask = gt(counts, 0);
    ok({bytes: compress(mask, range(256)), counts: compress(mask, counts)})
  } else {
    err({kind: "histogram", message: "histogram_nonzero expects 256 count bins"})
  }
}
