#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
release_mlpl="$repo_root/../sw-mlpl/target/release/mlpl-repl"
debug_mlpl="$repo_root/../sw-mlpl/target/debug/mlpl-repl"

if [ -n "${MLPL:-}" ]; then
  case "$MLPL" in
    /*) candidate=$MLPL ;;
    *) echo "MLPL must be an absolute path: $MLPL" >&2; exit 1 ;;
  esac
elif [ -x "$release_mlpl" ]; then
  candidate=$release_mlpl
elif [ -x "$debug_mlpl" ]; then
  candidate=$debug_mlpl
else
  echo "sw-MLPL executable not found" >&2
  echo "set MLPL=/absolute/path/to/mlpl-repl or build the adjacent sw-mlpl checkout" >&2
  exit 1
fi

if [ ! -f "$candidate" ] || [ ! -x "$candidate" ]; then
  echo "MLPL is not an executable file: $candidate" >&2
  exit 1
fi

printf '%s\n' "$candidate"
