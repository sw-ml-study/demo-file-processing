#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output=$("$repo_root/scripts/run-binary-demo" mpeg_header)
printf '%s\n' "$output" | grep -Fqx 'field widths: 11 2 2 1 4 2 1 1 2 2 1 1 2'
printf '%s\n' "$output" | grep -Fqx 'field values: 2047 3 1 1 9 0 0 0 1 2 0 1 0'

echo "PASS binary demos"
