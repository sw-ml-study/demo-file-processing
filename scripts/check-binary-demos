#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output=$("$repo_root/scripts/run-binary-demo" mpeg_header)
printf '%s\n' "$output" | grep -Fqx 'Semantic MPEG audio-header demonstration'
printf '%s\n' "$output" | grep -Fqx 'Case 1 interpretation: a common 128 kbit/s, 44.1 kHz joint-stereo MPEG-1 frame uses the 144× formula and needs 417 bytes.'
printf '%s\n' "$output" | grep -Fqx 'Case 2 interpretation: the de-facto MPEG-2.5 extension quarters the MPEG-1 rate and uses 576 samples plus the 72× frame formula.'
printf '%s\n' "$output" | grep -Fqx 'Policy: free-bitrate index 0 is explicit Err because header bytes alone cannot determine frame length; a scanner must infer sync distance.'

echo "PASS binary demos"
