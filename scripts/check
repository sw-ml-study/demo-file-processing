#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

"$repo_root/scripts/audit"
"$repo_root/tests/test-validation"
"$repo_root/scripts/run-tests" --format tap >/dev/null
"$repo_root/scripts/check-process-io"
"$repo_root/scripts/check-write-stdout"
"$repo_root/scripts/check-stdout-demos"
"$repo_root/scripts/check-compiler"
"$repo_root/scripts/check-compiled-byte-apps"
"$repo_root/scripts/check-compiled-format-apps"
"$repo_root/scripts/check-compiled-file-tools"
"$repo_root/scripts/check-compiled-wc-stdin"
"$repo_root/scripts/check-standalone-artifact"
"$repo_root/scripts/check-media-inspector"
"$repo_root/scripts/check-media-doctor"
"$repo_root/scripts/check-wav-transform"
"$repo_root/scripts/check-date-index-demo"
"$repo_root/scripts/check-wc-demo"
"$repo_root/scripts/check-grep-demo"
"$repo_root/scripts/check-du-demo"
"$repo_root/scripts/check-ls-demo"
"$repo_root/scripts/check-byte-demos"
"$repo_root/scripts/check-copy-demo"
"$repo_root/scripts/check-binary-demos"
"$repo_root/scripts/check-mp3-demos"
"$repo_root/scripts/check-ogg-demos"
"$repo_root/scripts/check-wav-demo"
git -C "$repo_root" diff --check

echo "PASS pre-commit"
