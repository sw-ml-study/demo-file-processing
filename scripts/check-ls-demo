#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
output=$("$repo_root/scripts/run-ls-demo")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/demo-file-ls.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

printf '%s\n' "$output" | grep -Fqx 'Confined ls-like metadata demonstration'
printf '%s\n' "$output" | grep -Eq '^Live row 1: fixtures/bytes/all-bytes\.bin file 256 bytes [0-9]+ ms [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z$'
printf '%s\n' "$output" | grep -Eq '^Live row 2: fixtures/bytes/boundary-17\.bin file 17 bytes [0-9]+ ms '
printf '%s\n' "$output" | grep -Eq '^Live row 3: fixtures/bytes/empty\.bin file 0 bytes [0-9]+ ms '
printf '%s\n' "$output" | grep -Eq '^Live row 4: fixtures/bytes/generate\.mlpl file 287 bytes [0-9]+ ms '
printf '%s\n' "$output" | grep -Eq '^Live row 5: fixtures/bytes/repeated-7\.bin file 12 bytes [0-9]+ ms '
printf '%s\n' "$output" | grep -Eq '^Live row 6: fixtures/bytes/singleton-ff\.bin file 1 bytes [0-9]+ ms '
printf '%s\n' "$output" | grep -Fqx 'Synthetic date order 1: models/alpha.bin dir 2024-01-01T00:00:00.123Z'
printf '%s\n' "$output" | grep -Fqx 'Synthetic date order 2: models/zeta.bin file 2024-01-01T00:00:00.123Z'
printf '%s\n' "$output" | grep -Fqx 'Synthetic date order 3: offline/missing.bin other timestamp unavailable'

oracle=$(printf '%s\n' "$output" | awk '/^Host oracle fields:/ { print $4, $5, $6 }')
set -- $oracle
path=$1; reported_size=$2; reported_ms=$3
[ -f "$repo_root/$path" ]
host_size=$(wc -c <"$repo_root/$path" | tr -d ' ')
[ "$host_size" -eq "$reported_size" ]
case $(uname -s) in
  Darwin) host_seconds=$(stat -f %m "$repo_root/$path") ;;
  Linux) host_seconds=$(stat -c %Y "$repo_root/$path") ;;
  *) echo "unsupported host for timestamp oracle: $(uname -s)" >&2; exit 1 ;;
esac
[ "$host_seconds" -eq $((reported_ms / 1000)) ]

cp "$repo_root/fixtures/bytes/singleton-ff.bin" "$scratch/inside.bin"
ln -s "$repo_root/README.md" "$scratch/escape.bin"
"$mlpl" --source-dir "$scratch" "$repo_root/probes/file_metadata_path.mlpl" -- inside.bin >"$scratch/inside.out"
grep -Fq 'Ok({kind: file' "$scratch/inside.out"
missing_status=0
"$mlpl" --source-dir "$scratch" "$repo_root/probes/file_metadata_path.mlpl" -- missing.bin >"$scratch/missing.out" 2>"$scratch/missing.err" || missing_status=$?
[ "$missing_status" -ne 0 ]
escape_status=0
"$mlpl" --source-dir "$scratch" "$repo_root/probes/file_metadata_path.mlpl" -- escape.bin >"$scratch/escape.out" 2>"$scratch/escape.err" || escape_status=$?
[ "$escape_status" -ne 0 ]

echo "PASS self-describing ls-like demo, host metadata parity, and confinement errors"
