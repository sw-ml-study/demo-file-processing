#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for path in .env .env.local .capability-test.bin .wav-copy-output.wav out/result.bin target/debug/tool artifacts/song.mp3 media/song.ogg .agentrail/sessions/session.jsonl; do
  git -C "$repo_root" check-ignore -q "$path" || {
    echo "required generated/local path is not ignored: $path" >&2
    exit 1
  }
done

for path in fixtures/tiny.wav .agentrail/saga.toml COPYRIGHT LICENSE; do
  if git -C "$repo_root" check-ignore -q "$path"; then
    echo "required durable path is ignored: $path" >&2
    exit 1
  fi
done

echo "PASS gitignore"
