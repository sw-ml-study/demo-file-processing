#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mlpl_build=$("$repo_root/scripts/select-mlpl-build")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/demo-file-compiler.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

interpreted=$("$mlpl" "$repo_root/probes/compiler_numeric.mlpl")
"$mlpl_build" "$repo_root/probes/compiler_numeric.mlpl" -o "$scratch/compiler-numeric" >/dev/null
compiled=$("$scratch/compiler-numeric")
[ "$compiled" = "$interpreted" ] || {
  echo "compiler parity mismatch: interpreter=$interpreted compiled=$compiled" >&2
  exit 1
}

mkdir "$scratch/file-interpreted" "$scratch/file-compiled"
cp "$repo_root/probes/compiler_file_io.mlpl" "$scratch/file-interpreted/probe.mlpl"
cp "$repo_root/probes/compiler_file_io.mlpl" "$scratch/file-compiled/probe.mlpl"
printf '\001\002\377' >"$scratch/file-interpreted/input.bin"
cp "$scratch/file-interpreted/input.bin" "$scratch/file-compiled/input.bin"
(cd "$scratch/file-interpreted" && "$mlpl" probe.mlpl) >"$scratch/file-interpreted.out"
"$mlpl_build" "$scratch/file-compiled/probe.mlpl" -o "$scratch/compiler-file-io" >/dev/null
(cd "$scratch/file-compiled" && "$scratch/compiler-file-io") >"$scratch/file-compiled.out"
printf 'Ok(1 2 255)\nOk(1 2 255)\n' >"$scratch/file-interpreted.expected"
printf 'ok(1 2 255)\n' >"$scratch/file-compiled.expected"
cmp "$scratch/file-interpreted.expected" "$scratch/file-interpreted.out"
cmp "$scratch/file-compiled.expected" "$scratch/file-compiled.out"

cat >"$scratch/args.mlpl" <<'EOF'
write_stdout(args())
EOF
"$mlpl_build" "$scratch/args.mlpl" -o "$scratch/compiler-args" >/dev/null
"$scratch/compiler-args" alpha beta >"$scratch/args.actual"
printf 'alpha\nbeta' >"$scratch/args.expected"
cmp "$scratch/args.expected" "$scratch/args.actual"

"$mlpl_build" "$repo_root/probes/compiler_arg.mlpl" -o "$scratch/compiler-arg" >/dev/null
"$scratch/compiler-arg" alpha beta >"$scratch/arg.actual"
printf 'beta' >"$scratch/arg.expected"
cmp "$scratch/arg.expected" "$scratch/arg.actual"

"$mlpl_build" "$repo_root/probes/compiler_invalid_stdout.mlpl" -o "$scratch/compiler-invalid-stdout" >/dev/null
invalid_stdout_status=0
"$scratch/compiler-invalid-stdout" >"$scratch/invalid-stdout.out" 2>"$scratch/invalid-stdout.actual" || invalid_stdout_status=$?
[ "$invalid_stdout_status" -ne 0 ]
[ ! -s "$scratch/invalid-stdout.out" ]
printf 'write_stdout: cell 0 = 256 is not an integer in 0..=255\n' >"$scratch/invalid-stdout.expected"
cmp "$scratch/invalid-stdout.expected" "$scratch/invalid-stdout.actual"

"$mlpl_build" "$repo_root/probes/compiler_read_stdin.mlpl" -o "$scratch/compiler-read-stdin" >/dev/null
printf 'alpha\nbeta\n' | "$scratch/compiler-read-stdin" >"$scratch/read-stdin.actual" 2>"$scratch/read-stdin.err"
printf 'alpha\nbeta\n' >"$scratch/read-stdin.expected"
cmp "$scratch/read-stdin.expected" "$scratch/read-stdin.actual"
[ ! -s "$scratch/read-stdin.err" ]

"$mlpl_build" "$repo_root/probes/compiler_print.mlpl" -o "$scratch/compiler-print" >/dev/null
"$scratch/compiler-print" >"$scratch/print.actual" 2>"$scratch/print.err"
printf 'stdout\nstdout\n' >"$scratch/print.expected"
cmp "$scratch/print.expected" "$scratch/print.actual"
[ ! -s "$scratch/print.err" ]

"$mlpl_build" "$repo_root/probes/compiler_eprint.mlpl" -o "$scratch/compiler-eprint" >/dev/null
"$scratch/compiler-eprint" >"$scratch/eprint.out" 2>"$scratch/eprint.actual"
printf 'stderr\n' >"$scratch/eprint.expected"
cmp "$scratch/eprint.expected" "$scratch/eprint.out"
cmp "$scratch/eprint.expected" "$scratch/eprint.actual"

"$mlpl_build" "$repo_root/probes/compiler_exit.mlpl" -o "$scratch/compiler-exit" >/dev/null 2>"$scratch/exit.build.err"
exit_status=0
"$scratch/compiler-exit" >"$scratch/exit.out" 2>"$scratch/exit.err" || exit_status=$?
[ "$exit_status" -eq 7 ]
[ ! -s "$scratch/exit.out" ]
[ ! -s "$scratch/exit.err" ]

bits_interpreted=$("$mlpl" "$repo_root/probes/compiler_bits.mlpl")
"$mlpl_build" "$repo_root/probes/compiler_bits.mlpl" -o "$scratch/compiler-bits" >/dev/null
bits_compiled=$("$scratch/compiler-bits")
[ "$bits_compiled" = "$bits_interpreted" ] || {
  echo "compiler bit parity mismatch: interpreter=$bits_interpreted compiled=$bits_compiled" >&2
  exit 1
}

mkdir "$scratch/append-interpreted" "$scratch/append-compiled"
cp "$repo_root/probes/compiler_append.mlpl" "$scratch/append-interpreted/probe.mlpl"
cp "$repo_root/probes/compiler_append.mlpl" "$scratch/append-compiled/probe.mlpl"
(cd "$scratch/append-interpreted" && "$mlpl" probe.mlpl) >"$scratch/append-interpreted.out"
"$mlpl_build" "$scratch/append-compiled/probe.mlpl" -o "$scratch/compiler-append" >/dev/null
(cd "$scratch/append-compiled" && "$scratch/compiler-append") >"$scratch/append-compiled.out"
printf 'Ok(3)\n' >"$scratch/append-interpreted.expected"
: >"$scratch/append-compiled.expected"
cmp "$scratch/append-interpreted.expected" "$scratch/append-interpreted.out"
cmp "$scratch/append-compiled.expected" "$scratch/append-compiled.out"
cmp "$scratch/append-interpreted/out.bin" "$scratch/append-compiled/out.bin"

"$mlpl_build" "$repo_root/probes/compiler_stdout.mlpl" -o "$scratch/compiler-stdout" >/dev/null
"$scratch/compiler-stdout" >"$scratch/stdout.actual"
printf '\000\377' >"$scratch/stdout.expected"
cmp "$scratch/stdout.expected" "$scratch/stdout.actual"

arithmetic_interpreted=$("$mlpl" "$repo_root/probes/compiler_arithmetic.mlpl")
"$mlpl_build" "$repo_root/probes/compiler_arithmetic.mlpl" -o "$scratch/compiler-arithmetic" >/dev/null
arithmetic_compiled=$("$scratch/compiler-arithmetic")
[ "$arithmetic_compiled" = "$arithmetic_interpreted" ] || {
  echo "compiler arithmetic parity mismatch: interpreter=$arithmetic_interpreted compiled=$arithmetic_compiled" >&2
  exit 1
}

if command -v otool >/dev/null 2>&1; then
  otool -L "$scratch/compiler-numeric" > "$scratch/libraries"
  if grep -Eq 'mlpl-repl|mlpl-parser|mlpl-eval' "$scratch/libraries"; then
    echo "compiled numeric artifact links an interpreter/parser component" >&2
    exit 1
  fi
fi

echo "PASS compiler numeric/arithmetic/bit parity, read/append lowering and bytes, exact current process output, and remaining application boundaries ($compiled, $arithmetic_compiled)"
