#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
name=${1:?usage: run-ogg-demo pages|packets|crc|bounded_output|oracle}
case "$name" in pages|packets|crc|bounded_output|oracle) : ;; *) echo "unknown Ogg demo: $name" >&2; exit 2 ;; esac
mlpl=$("$repo_root/scripts/select-mlpl")
exec "$mlpl" --source-dir "$repo_root" "$repo_root/demos/ogg/$name.mlpl"
