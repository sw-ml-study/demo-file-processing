#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
name=${1:?usage: run-byte-demo hexdump|histogram|range_histogram}
case "$name" in
  hexdump|histogram|range_histogram) : ;;
  *) echo "unknown byte demo: $name" >&2; exit 2 ;;
esac

mlpl=$("$repo_root/scripts/select-mlpl")
exec "$mlpl" --source-dir "$repo_root" "$repo_root/demos/bytes/$name.mlpl"
