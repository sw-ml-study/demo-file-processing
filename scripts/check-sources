#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for script in "$repo_root"/scripts/* "$repo_root"/tests/test-*; do
  [ -f "$script" ] || continue
  sh -n "$script"
  [ -x "$script" ] || {
    echo "script is not executable: ${script#"$repo_root"/}" >&2
    exit 1
  }
done

if find "$repo_root" -path "$repo_root/.git" -prune -o -type f -name '*.mlpl' -print | grep -q .; then
  if grep -RIl "$(printf '\r')" "$repo_root" --include='*.mlpl' | grep -q .; then
    echo "MLPL sources must use LF line endings" >&2
    exit 1
  fi
fi

if find "$repo_root/probes" -type f -name '*.mlpl' -perm -111 -print | grep -q .; then
  echo "probe MLPL sources must be invoked by checked wrappers, not executable ad hoc tests" >&2
  exit 1
fi

echo "PASS sources"
