#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
source=${1:-fixtures/wav/minimal-mono8.wav}
destination=${2:-.wav-tool-output.wav}
mode=${3:-invert_u8}
chunk_size=${4:-2}
exec "$mlpl" --source-dir "$repo_root" "$repo_root/demos/apps/wav_transform.mlpl" -- "$source" "$destination" "$mode" "$chunk_size"
