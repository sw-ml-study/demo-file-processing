#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl_build=$("$repo_root/scripts/select-mlpl-build")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/demo-file-byte-apps.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

expect_rejection() {
  name=$1
  source=$2
  pattern=$3
  shift 3
  if "$mlpl_build" "$source" -o "$scratch/$name" "$@" >"$scratch/$name.out" 2>"$scratch/$name.err"; then
    echo "compiler unexpectedly accepted blocked $name application" >&2
    exit 1
  fi
  grep -Fq "$pattern" "$scratch/$name.err"
}

expect_rejection hexdump "$repo_root/demos/bytes/hexdump.mlpl" 'unsupported construct: fncall tally/1' --source-dir "$repo_root"
expect_rejection histogram "$repo_root/demos/bytes/histogram.mlpl" 'unsupported construct: fncall tally/1' --source-dir "$repo_root"

{
  sed '/^include /d' "$repo_root/src/bytes/validate.mlpl"
  sed '/^include /d' "$repo_root/src/bytes/hex.mlpl"
  sed '/^include /d' "$repo_root/demos/bytes/hexdump.mlpl"
} >"$scratch/hexdump-flat.mlpl"
expect_rejection hexdump-flat "$scratch/hexdump-flat.mlpl" 'unsupported construct: fncall tally/1'

{
  sed '/^include /d' "$repo_root/src/bytes/validate.mlpl"
  sed '/^include /d' "$repo_root/src/bytes/histogram.mlpl"
  sed '/^include /d' "$repo_root/demos/bytes/histogram.mlpl"
} >"$scratch/histogram-flat.mlpl"
expect_rejection histogram-flat "$scratch/histogram-flat.mlpl" 'unsupported construct: fncall tally/1'

echo "PASS compiled byte applications pass comparisons and stop at tally/1 lowering"
