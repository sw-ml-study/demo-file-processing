#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl_build=$("$repo_root/scripts/select-mlpl-build")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/demo-file-format-apps.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

expect_rejection() {
  name=$1
  source=$2
  pattern=$3
  if "$mlpl_build" "$source" -o "$scratch/$name" >"$scratch/$name.out" 2>"$scratch/$name.err"; then
    echo "compiler unexpectedly accepted blocked $name application" >&2
    exit 1
  fi
  grep -Fq "$pattern" "$scratch/$name.err"
}

expect_rejection wav "$repo_root/demos/wav/bounded_output.mlpl" 'unsupported construct: include "../../src/bytes/validate.mlpl"'
expect_rejection ogg "$repo_root/demos/ogg/bounded_output.mlpl" 'unsupported construct: include "../../src/bytes/validate.mlpl"'

{
  sed '/^include /d' "$repo_root/src/bytes/validate.mlpl"
  sed '/^include /d' "$repo_root/src/binary/slice.mlpl"
  sed '/^include /d' "$repo_root/src/binary/endian_decode.mlpl"
  sed '/^include /d' "$repo_root/src/binary/endian_encode.mlpl"
  sed '/^include /d' "$repo_root/src/wav/model.mlpl"
  sed '/^include /d' "$repo_root/src/wav/chunks.mlpl"
  sed '/^include /d' "$repo_root/src/wav/parse.mlpl"
  sed '/^include /d' "$repo_root/src/wav/range_inspect.mlpl"
  sed '/^include /d' "$repo_root/src/wav/bounded_output.mlpl"
  sed '/^include /d' "$repo_root/demos/wav/bounded_output.mlpl"
} >"$scratch/wav-flat.mlpl"
expect_rejection wav-flat "$scratch/wav-flat.mlpl" 'unsupported construct: FnDef'

{
  sed '/^include /d' "$repo_root/src/bytes/validate.mlpl"
  sed '/^include /d' "$repo_root/src/binary/slice.mlpl"
  sed '/^include /d' "$repo_root/src/binary/endian_decode.mlpl"
  sed '/^include /d' "$repo_root/src/binary/endian_encode.mlpl"
  sed '/^include /d' "$repo_root/src/binary/bit_fields.mlpl"
  sed '/^include /d' "$repo_root/src/ogg/page.mlpl"
  sed '/^include /d' "$repo_root/src/ogg/crc.mlpl"
  sed '/^include /d' "$repo_root/src/ogg/bounded_output.mlpl"
  sed '/^include /d' "$repo_root/demos/ogg/bounded_output.mlpl"
} >"$scratch/ogg-flat.mlpl"
expect_rejection ogg-flat "$scratch/ogg-flat.mlpl" 'unsupported construct: FnDef'

echo "PASS compiled WAV/Ogg application blockers: source loading and function lowering"
