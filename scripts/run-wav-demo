#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
name=${1:-inspect_copy}
case "$name" in
  inspect_copy|range_inspect) : ;;
  *) echo "unknown WAV demo: $name" >&2; exit 2 ;;
esac
mlpl=$("$repo_root/scripts/select-mlpl")
exec "$mlpl" --source-dir "$repo_root" "$repo_root/demos/wav/$name.mlpl"
