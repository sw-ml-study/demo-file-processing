#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
max_fixture_bytes=1048576

"$repo_root/scripts/generate-byte-fixtures" --check >/dev/null
"$repo_root/scripts/generate-wav-fixtures" --check >/dev/null
"$repo_root/scripts/generate-mp3-fixtures" --check >/dev/null

if [ -d "$repo_root/fixtures" ]; then
  if find "$repo_root/fixtures" -type l -print | grep -q .; then
    echo "fixtures must not be symbolic links" >&2
    exit 1
  fi
  oversized=$(find "$repo_root/fixtures" -type f -size +${max_fixture_bytes}c -print)
  if [ -n "$oversized" ]; then
    echo "fixtures exceed $max_fixture_bytes bytes:" >&2
    echo "$oversized" >&2
    exit 1
  fi
fi

tracked_media=$(git -C "$repo_root" ls-files '*.mp3' '*.ogg' '*.wav' '*.flac' '*.bin' |
  awk '$0 !~ /^fixtures\// { print }')
if [ -n "$tracked_media" ]; then
  echo "binary/media artifacts must be tiny fixtures under fixtures/:" >&2
  echo "$tracked_media" >&2
  exit 1
fi

echo "PASS fixtures"
