#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl_build=$("$repo_root/scripts/select-mlpl-build")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/demo-file-unix-tools.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

expect_boundary() {
  name=$1
  source=$2
  if "$mlpl_build" "$source" -o "$scratch/$name" --source-dir "$repo_root" >"$scratch/$name.out" 2>"$scratch/$name.err"; then
    echo "compiler unexpectedly accepted $name; replace this boundary with positive artifact parity" >&2
    exit 1
  fi
  grep -Fq 'unsupported construct: fncall equal/2' "$scratch/$name.err"
}

expect_boundary wc-like "$repo_root/demos/files/wc.mlpl"
expect_boundary grep-like "$repo_root/demos/files/grep.mlpl"
expect_boundary du-like "$repo_root/demos/files/du.mlpl"

echo "PASS compiled wc/grep/du sources advance through tally/take and stop at equal/2 lowering"
