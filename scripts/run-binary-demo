#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
name=${1:?usage: run-binary-demo mpeg_header}
case "$name" in
  mpeg_header) : ;;
  *) echo "unknown binary demo: $name" >&2; exit 2 ;;
esac

mlpl=$("$repo_root/scripts/select-mlpl")
exec "$mlpl" --source-dir "$repo_root" "$repo_root/demos/binary/$name.mlpl"
