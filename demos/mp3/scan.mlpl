include "../../src/bytes/validate.mlpl";
include "../../src/binary/endian_decode.mlpl";
include "../../src/binary/bit_fields.mlpl";
include "../../src/id3/inspect.mlpl";
include "../../src/mp3/scanner.mlpl";

path = "fixtures/mp3/synthetic-vbr-id3.mp3";
tag = u:inspect_id3v2(path, 7, 4096, 16, 256)?;
scan = u:scan_mpeg_layer3(path, 7, tag.audio_offset, tag.audio_offset + tag.audio_bytes, tag.audio_bytes, 16)?;
scan_large = u:scan_mpeg_layer3(path, 65536, tag.audio_offset, tag.audio_offset + tag.audio_bytes, tag.audio_bytes, 16)?;
damaged_path = "fixtures/mp3/resync-gap.mp3";
damaged_size = file_size(damaged_path)?;
damaged = u:scan_mpeg_layer3(damaged_path, 7, 0, damaged_size, damaged_size, 8)?;
if equal(scan, scan_large) * eq(scan.frames, 3) * eq(damaged.frames, 4) {
  print("Bounded MPEG frame-scanner demonstration");
  print("Purpose: inspect frame geometry and bitrate changes without decoding or retaining compressed audio payloads.");
  print("Input A: generated structural MP3 evidence with an ID3 tag followed by 128, 160, and 128 kbit/s MPEG-1 Layer III frames.");
  print("MLPL work: parse ID3 bounds, acquire two-header synchronization, skip payloads by decoded lengths, and aggregate frame/sample/bitrate facts.");
  print("Native runtime work: file size and bounded offset/length reads only; no MPEG parser, decoder, ffprobe, or codec extension participates.");
  print("Output A: frames", scan.frames, "; bitrate range", scan.min_bitrate_kbps, "to", scan.max_bitrate_kbps, "kbit/s; 128/160 bins", take(scan.bitrate_histogram, 0, 9), "/", take(scan.bitrate_histogram, 0, 10), "; frame-size range", scan.min_frame_length, "to", scan.max_frame_length, "bytes.");
  print("Channel output A: joint-stereo frames", take(scan.channel_mode_histogram, 0, 1), "; mono frames", take(scan.channel_mode_histogram, 0, 3), "; samples", scan.total_samples, ".");
  print("Interpretation A: unequal bitrate bins prove VBR, the frame-size range follows those rates, and chunk budgets 7 and 65,536 produce the same complete result.");
  print("Input B: four 128 kbit/s frames with a deliberate two-byte damaged gap between frame pairs.");
  print("Output B: frames", damaged.frames, "; skipped bytes", damaged.skipped_bytes, "; resynchronizations", damaged.resyncs, "; audio end", damaged.audio_end, ".");
  print("Interpretation B: the scanner loses synchronization at the gap, searches byte-by-byte, and requires a compatible next frame before accepting the recovered stream.");
  print("Boundary: these structural fixtures contain synthetic non-audio payloads; the opt-in pinned ffprobe oracle uses a separate decodable 440 Hz fixture.");
  ok({vbr_frames: scan.frames, bitrate_changes: scan.bitrate_changes, recovered_frames: damaged.frames, resynchronizations: damaged.resyncs})
} else {
  err({kind: "invariant", message: "bounded scanner demonstration changed"})
}
