include "../../src/bytes/validate.mlpl";
include "../../src/binary/endian_decode.mlpl";
include "../../src/binary/bit_fields.mlpl";
include "../../src/mp3/header.mlpl";

mpeg1 = u:parse_mpeg_layer3_header([255, 251, 144, 100])?;
mpeg25 = u:parse_mpeg_layer3_header([255, 227, 64, 192])?;
if eq(mpeg1.frame_length, 417) * eq(mpeg25.frame_length, 208) {
  print("Semantic MPEG audio-header demonstration");
  print("Purpose: turn packed cross-byte selectors into validated Layer III frame geometry without a format-specific native parser.");
  print("MLPL work: expand bytes to MSB-first fields, reject reserved selectors, apply versioned bitrate/rate tables, and derive frame length.");
  print("Native runtime work: fixed-width bit operations only; no MPEG parser or external tool is used.");
  print("Case 1 input: FF FB 90 64.");
  print("Case 1 output:", mpeg1.version, mpeg1.layer, mpeg1.bitrate_kbps, "kbit/s", mpeg1.sample_rate_hz, "Hz", mpeg1.channel_mode, ";", mpeg1.frame_samples, "samples and", mpeg1.frame_length, "bytes per frame.");
  print("Case 1 interpretation: a common 128 kbit/s, 44.1 kHz joint-stereo MPEG-1 frame uses the 144× formula and needs 417 bytes.");
  print("Case 2 input: FF E3 40 C0.");
  print("Case 2 output:", mpeg25.version, mpeg25.layer, mpeg25.bitrate_kbps, "kbit/s", mpeg25.sample_rate_hz, "Hz", mpeg25.channel_mode, ";", mpeg25.frame_samples, "samples and", mpeg25.frame_length, "bytes per frame.");
  print("Case 2 interpretation: the de-facto MPEG-2.5 extension quarters the MPEG-1 rate and uses 576 samples plus the 72× frame formula.");
  print("Policy: free-bitrate index 0 is explicit Err because header bytes alone cannot determine frame length; a scanner must infer sync distance.");
  ok({headers: 2, mpeg1_frame_bytes: mpeg1.frame_length, mpeg25_frame_bytes: mpeg25.frame_length})
} else { err({kind: "invariant", message: "MPEG header fields changed"}) }
