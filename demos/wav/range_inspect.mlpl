include "../../src/bytes/validate.mlpl";
include "../../src/binary/slice.mlpl";
include "../../src/binary/endian_decode.mlpl";
include "../../src/wav/model.mlpl";
include "../../src/wav/parse.mlpl";
include "../../src/wav/range_inspect.mlpl";

wav = u:inspect_wav_ranges("fixtures/wav/odd-unknown-mono8.wav", 7, 8)?;
if eq(wav.channels, 1) * eq(wav.sample_rate, 8000) * eq(wav.data_bytes, 1) * eq(wav.frames, 1) * eq(wav.unknown_chunks, 1) {
  print("Bounded PCM WAV metadata-inspection demonstration");
  print("Purpose: inspect RIFF metadata without materializing audio or unknown payloads.");
  print("Input: an 8-bit mono 8000 Hz fixture containing an odd three-byte JUNK chunk, its pad byte, and one audio byte.");
  print("MLPL work: assemble split headers, validate declared extents and padding, skip payloads by offset, and derive frame metadata.");
  print("Native runtime work: report file size and serve ranges of at most 7 bytes.");
  print("Output: data offset", wav.data_offset, "; data bytes", wav.data_bytes, "; frames", wav.frames, "; unknown chunks", wav.unknown_chunks, ".");
  print("Interpretation: the padded JUNK chunk moves audio to byte 56, while the result retains no sample-data field.");
  print("Contrast: unlike the canonical-copy demo, this path reads metadata only and performs no output write.");
  ok(wav)
} else {
  err({kind: "invariant", message: "bounded WAV metadata changed"})
}
