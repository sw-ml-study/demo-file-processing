include "../../src/bytes/validate.mlpl";
include "../../src/ogg/crc.mlpl";

valid = u:verify_ogg_page_crc("fixtures/ogg/structural-cross-page.ogg", 7, 0, 512, 8, 300, 512, 7)?; corrupt = u:inspect_ogg_page_crc("fixtures/ogg/malformed-crc.ogg", 7, 0, 512, 8, 300, 512, 7)?;
if valid.valid * (1 - corrupt.valid) {
  print("Visible Ogg CRC demonstration");
  print("Purpose: verify page integrity with the Ogg polynomial visibly implemented in MLPL rather than delegated to a native checksum library.");
  print("Input: one generated checksum-valid page and a separate fixture whose first-page body byte was changed after checksum encoding.");
  print("MLPL work: stream bounded page chunks, logically zero checksum bytes 22 through 25, and apply polynomial 0x04C11DB7 for eight bit steps per byte.");
  print("Native runtime work: bounded reads and generic fixed-width bit operations only; no Ogg or CRC implementation is hidden outside MLPL.");
  print("Valid output: stored", valid.stored, "; computed", valid.computed, "; match", valid.valid, ".");
  print("Corrupt output: stored", corrupt.stored, "; computed", corrupt.computed, "; match", corrupt.valid, ".");
  print("Interpretation: structural parsing can still describe a damaged page, while required CRC verification rejects the changed payload deterministically.");
  print("Boundary: integrity verification reads bytes but does not decode packets or write repaired output.");
  ok({valid: valid.valid, corrupt_valid: corrupt.valid})
} else { err({kind: "invariant", message: "Ogg CRC demo changed"}) }
